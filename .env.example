# Copy this file to .env and replace the example values with your local
# PostgreSQL and application settings.
#
# Never commit .env or real credentials and secret keys to a public repository.

# PostgreSQL credentials
DB_USER=your_postgresql_user
DB_PASSWORD=choose-a-strong-password
DB_HOST=localhost
DB_PORT_POSTGRESQL=5432

# Database used by FastAPI
DB_NAME=your_fastapi_database

# Database used by Django
DJANGO_DB_NAME=your_django_database

# Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# FastAPI admin API key
ADMIN_SECRET=replace-with-a-strong-secret
